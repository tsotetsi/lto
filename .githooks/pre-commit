#!/bin/sh
#
# Pre-commit hook for Lethathamo
# Runs the backend test suite before each commit.
# Skip with: SKIP_TESTS=1 git commit
#

if [ -n "$SKIP_TESTS" ]; then
    echo "  ↪ SKIP_TESTS set — skipping pre-commit tests"
    exit 0
fi

echo ""
echo "━━━ Pre-commit: Running backend tests ━━━"
echo ""

# Only run tests if backend files changed
CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -c '^backend/' || true)

if [ "$CHANGED" = "0" ]; then
    echo "  ✓ No backend changes — tests skipped"
    echo ""
    exit 0
fi

# Check that the backend container is running and healthy
CONTAINER_STATUS=$(docker compose ps backend --format '{{.Status}}' 2>/dev/null || echo "")

case "$CONTAINER_STATUS" in
    *healthy*|*Up*)
        # Container is running — proceed
        ;;
    *)
        echo "  ⚠ Backend container is not running."
        echo "  Start it with: make backend-up"
        echo "  Then retry your commit."
        echo "  To skip: SKIP_TESTS=1 git commit"
        echo ""
        exit 1
        ;;
esac

# Run the tests — show full output on failure
OUTPUT=$(docker compose exec -u appuser backend python -m pytest tests/ --tb=short 2>&1)
EXIT_CODE=$?

if [ "$EXIT_CODE" -ne 0 ]; then
    echo ""
    echo "$OUTPUT"
    echo ""
    echo "  ✗ Tests FAILED (exit $EXIT_CODE)"
    echo "  Fix the failing tests, then commit again."
    echo "  To skip: SKIP_TESTS=1 git commit"
    echo ""
    exit 1
fi

echo "  ✓ All tests passed"
echo ""
exit 0
