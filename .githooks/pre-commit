#!/bin/sh
#
# Pre-commit hook for Lethathamo
# Runs backend and frontend test suites before each commit.
# Skip with: SKIP_TESTS=1 git commit
#

if [ -n "$SKIP_TESTS" ]; then
    echo "  ↪ SKIP_TESTS set — skipping pre-commit tests"
    exit 0
fi

echo ""
echo "━━━ Pre-commit: Running tests ━━━"
echo ""

# Check which files changed
BACKEND_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -c '^backend/' || true)
FRONTEND_CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -c '^frontend/' || true)

if [ "$BACKEND_CHANGED" = "0" ] && [ "$FRONTEND_CHANGED" = "0" ]; then
    echo "  ✓ No backend or frontend changes — tests skipped"
    echo ""
    exit 0
fi

ALL_PASSED=true

# ── Backend tests ──────────────────────────────────────────────────────────────

if [ "$BACKEND_CHANGED" -gt 0 ]; then
    echo "  → Backend files changed — running backend tests..."

    # Check that the backend container is running and healthy
    CONTAINER_STATUS=$(docker compose ps backend --format '{{.Status}}' 2>/dev/null || echo "")

    case "$CONTAINER_STATUS" in
        *healthy*|*Up*)
            # Container is running — proceed
            ;;
        *)
            echo "  ⚠ Backend container is not running."
            echo "    Start it with: make backend-up"
            echo "    Then retry your commit."
            echo "    To skip: SKIP_TESTS=1 git commit"
            echo ""
            exit 1
            ;;
    esac

    # Run the tests — show full output on failure
    BACKEND_OUTPUT=$(docker compose exec -u appuser backend python -m pytest tests/ --tb=short 2>&1)
    BACKEND_EXIT=$?

    if [ "$BACKEND_EXIT" -ne 0 ]; then
        echo ""
        echo "$BACKEND_OUTPUT"
        echo ""
        echo "  ✗ Backend tests FAILED (exit $BACKEND_EXIT)"
        ALL_PASSED=false
    else
        echo "  ✓ Backend tests passed"
    fi
else
    echo "  → No backend changes — backend tests skipped"
fi

echo ""

# ── Frontend tests ─────────────────────────────────────────────────────────────

if [ "$FRONTEND_CHANGED" -gt 0 ]; then
    echo "  → Frontend files changed — running frontend tests..."

    FRONTEND_OUTPUT=$(cd frontend && npx jest --no-cache --ci 2>&1)
    FRONTEND_EXIT=$?

    if [ "$FRONTEND_EXIT" -ne 0 ]; then
        echo ""
        echo "$FRONTEND_OUTPUT"
        echo ""
        echo "  ✗ Frontend tests FAILED (exit $FRONTEND_EXIT)"
        ALL_PASSED=false
    else
        echo "  ✓ Frontend tests passed"
    fi
else
    echo "  → No frontend changes — frontend tests skipped"
fi

echo ""

if [ "$ALL_PASSED" = "true" ]; then
    echo "  ✓ All tests passed"
    echo ""
    exit 0
else
    echo "  ✗ Some tests FAILED — fix and commit again."
    echo "    To skip: SKIP_TESTS=1 git commit"
    echo ""
    exit 1
fi
